# Só para o modo servidor (instalar.sh, com MySQL). Sem este arquivo, o app cria a própria configuração
# na pasta de dados, com SQLite, na primeira execução.
DB_HOST=localhost
DB_NAME=financeiro
DB_USER=financeiro_app
DB_PASS=troque_esta_senha
APP_ENV=production
SESSION_LIFETIME=28800
# 1 = a sobra só adianta o empréstimo se os meses seguintes continuarem acima da reserva
MOTOR_V2=1
# Opcionais. DB_DRIVER: mysql (padrão aqui) ou sqlite; com sqlite, DB_FILE e PASTA_DADOS dizem onde fica o banco.
# DB_DRIVER=sqlite
# DB_FILE=financeiro.sqlite
# PASTA_DADOS=/var/lib/financeiro
# CONFIAR_PROXY=1 faz valer X-Forwarded-Proto, só atrás de um proxy seu. HOSTS_PERMITIDOS limita os nomes aceitos.
# CONFIAR_PROXY=0
# HOSTS_PERMITIDOS=
