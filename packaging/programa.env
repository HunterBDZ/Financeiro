# O FrankenPHP que vai nos pacotes e o PHP que vem dentro dele, o mesmo nos três sistemas. Lido por empacotar.sh,
# windows/montar.sh e macos/montar.sh. Cada montagem confere o PHP no próprio arquivo, grava os dois em programa.json
# (ao lado de PACOTE) e o atualizacao.json os recomenda a quem tem um pacote mais velho (docs/LANCAR-VERSAO.md).
FRANKENPHP=1.13.4
PHP_DO_FRANKENPHP=8.5.12
