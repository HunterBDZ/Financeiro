# FrankenPHP no computador da pessoa, em HTTP. FIN_BIND vale 127.0.0.1 até a pessoa ligar a rede; quem confere o
# endereço pedido é o app (Rede::exigirHost). A pasta é absoluta: uma atualização troca a pasta app inteira.
# Uso: FIN_APP=/pasta/do/app PHP_INI_SCAN_DIR=packaging FIN_DADOS=/pasta frankenphp run --config packaging/Caddyfile
{
	auto_https off
	admin off
	persist_config off
	frankenphp
}

http://:{$FIN_PORTA:8484} {
	bind {$FIN_BIND:127.0.0.1}
	root * {$FIN_APP:public/..}/public
	@comPonto path_regexp (^|/)\.
	respond @comPonto 404
	encode zstd gzip
	php_server
}
