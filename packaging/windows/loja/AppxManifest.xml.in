<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap desktop rescap">
  <Identity Name="@NOME@" Publisher="@PUBLISHER@" Version="@VERSAO@.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Financeiro</DisplayName>
    <PublisherDisplayName>@PUBLICADO_POR@</PublisherDisplayName>
    <Logo>recursos\icone-50.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="pt-BR" />
    <Resource Language="en-US" />
    <Resource Language="es-ES" />
  </Resources>
  <Applications>
    <Application Id="Financeiro" Executable="financeiro-abrir.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Financeiro" Description="Financeiro" BackgroundColor="transparent"
                          Square150x150Logo="recursos\icone-150.png" Square44x44Logo="recursos\icone-44.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="financeiro-servir.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="FinanceiroServir" Enabled="true" DisplayName="Financeiro" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
